# Supply-chain defenses (npm 11). No dependency runs code at install time:
# the build and the wrangler deploy both work with esbuild's and workerd's
# postinstall held (site.yml, 2026-09-08), so nothing is approved. And
# `npm install`/`npm update` only resolve versions at least a week old;
# `npm ci` installs the lock as-is, so CI is unaffected.
ignore-scripts=true
min-release-age=7

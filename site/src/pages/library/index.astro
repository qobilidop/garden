---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { dateOf, extractTitle, fieldOf, shelfOf, workOf } from '../../lib/works'
import { entryPath, ingestedAt, newest } from '../../lib/recency'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const entries = (await getCollection('library')).map((e) => ({
  id: e.id,
  title: extractTitle(e.body ?? '') ?? e.id,
  shelf: shelfOf(e),
  author: workOf(e).author,
  synthesis: fieldOf(e, 'synthesis'),
  date: dateOf(e),
  timestamp: ingestedAt(entryPath(e.filePath)),
}))
const recent = newest([...entries], 5)

const byYear = new Map<string, typeof entries>()
for (const e of entries) {
  const year = e.shelf?.year ?? '????'
  if (!byYear.has(year)) byYear.set(year, [])
  byYear.get(year)!.push(e)
}
const years = [...byYear.keys()].sort((a, b) => b.localeCompare(a))
const shown = new Map<(typeof entries)[number], boolean>()
for (const year of years) {
  const list = byYear.get(year)!
  list.sort(
    (a, b) =>
      b.date.sortKey.localeCompare(a.date.sortKey) || a.id.localeCompare(b.id),
  )
  // Ledger convention: label a month only on its first (newest) entry.
  let prev: string | undefined
  for (const e of list) {
    shown.set(e, e.date.month !== undefined && e.date.month !== prev)
    prev = e.date.month ?? prev
  }
}
---

<Base title="library">
  <h1>Library</h1>
  <p>
    Papers and posts ingested into the system, each with synthesis notes.
    Grouped by publication year.
  </p>
  <section>
    <h2>Recently ingested</h2>
    <ul>
      {recent.map((e) => (
        <li>
          <a href={`${base}/library/${e.id}/`}>{e.title}</a>
        </li>
      ))}
    </ul>
  </section>
  {
    years.map((year) => (
      <section>
        <h2>{year}</h2>
        <ul class="work-list">
          {byYear.get(year)!.map((e) => (
            <li>
              <a href={`${base}/library/${e.id}/`}>{e.title}</a>
              <span class="tag">
                {shown.get(e) && <span class="month">{e.date.month} ·</span>}
                <span
                  class="kind"
                  data-kind={e.shelf?.kind === 'papers' ? 'paper' : 'post'}
                >
                  {e.shelf?.kind === 'papers' ? 'paper' : 'post'}
                </span>
              </span>
              {e.author && <span class="author">{e.author}</span>}
              {e.synthesis && <span class="synthesis">{e.synthesis}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

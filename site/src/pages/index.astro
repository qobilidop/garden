---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import {
  entryPath,
  ingestedAt,
  newest,
  surveyUpdatedAt,
  wikiUpdatedAt,
} from '../lib/recency'
import { extractTitle } from '../lib/works'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const tagline = 'A public knowledge base within a broader digital system.'
const wiki = await getCollection('wiki')
const library = await getCollection('library')
const surveys = await getCollection('surveys')
const RECENT_LIMIT = 5
const recentLibrary = newest(
  library.map((e) => ({
    id: e.id,
    title: extractTitle(e.body ?? '') ?? e.id,
    timestamp: ingestedAt(entryPath(e.filePath)),
  })),
  RECENT_LIMIT,
)
const recentWiki = newest(
  wiki.map((e) => ({
    id: e.id,
    title: extractTitle(e.body ?? '') ?? e.id,
    timestamp: wikiUpdatedAt(entryPath(e.filePath)),
  })),
  RECENT_LIMIT,
)
const recentSurveys = newest(
  surveys.map((e) => ({
    id: e.id,
    title: extractTitle(e.body ?? '') ?? e.id,
    timestamp: surveyUpdatedAt(e.id),
  })),
  RECENT_LIMIT,
)
---

<Base description={tagline}>
  <h1>qobilidop/sys0</h1>
  <p>{tagline}</p>

  <h2>Recently ingested library items</h2>
  <ul>
    {
      recentLibrary.map((w) => (
        <li>
          <a href={`${base}/library/${w.id}/`}>{w.title}</a>
        </li>
      ))
    }
  </ul>

  <h2>Recently updated wiki topics</h2>
  <ul>
    {
      recentWiki.map((e) => (
        <li>
          <a href={`${base}/wiki/${e.id}/`}>{e.title}</a>
        </li>
      ))
    }
  </ul>

  <h2>Recently updated surveys</h2>
  <ul>
    {
      recentSurveys.map((e) => (
        <li>
          <a href={`${base}/surveys/${e.id}/`}>{e.title}</a>
        </li>
      ))
    }
  </ul>
</Base>

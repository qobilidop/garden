---
import Base from '../layouts/Base.astro'
import Mark from '../components/Mark.astro'
import ProfileLinks from '../components/ProfileLinks.astro'
import { name, nameCJK } from '../lib/profile'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const tagline = 'Engineering for a living, research out of curiosity, share by default.'
const description = `${name} (${nameCJK}). ${tagline}`
---

<Base title={`${name} ${nameCJK}`} bare description={description}>
  <section class="profile">
    <Mark class="profile-mark" />
    <div class="profile-text">
      <h1 class="profile-name">
        {name} <span class="profile-name-cjk" lang="zh-Hans">{nameCJK}</span>
      </h1>
      <p class="profile-tagline">{tagline}</p>
      <ProfileLinks class="profile-contacts" />
    </div>
  </section>
  {/* Run-in anchors mirror the tagline's three clauses, one paragraph each. */}
  <p class="profile-intro">
    <strong>Engineering for a living:</strong> I'm a software engineer at
    Google, where I lead formal methods work for SmartNICs. I also serve on
    the <a href="https://p4.org/">P4</a> Technical Steering Team.
  </p>
  <p class="profile-intro">
    <strong>Research out of curiosity:</strong> Before software I spent ten
    years in physics, from a BS at Peking University to a PhD program in
    computational astrophysics at UC San Diego, which I left to retrain in
    computer science. The curiosity stayed.
  </p>
  <p class="profile-intro">
    <strong>Share by default:</strong> I share whatever can be shared. My code
    lands in open source. My notes grow in this digital garden: a
    <a href={`${base}/library/`}>library</a> of works I've read,
    <a href={`${base}/wiki/`}>wiki</a> topics distilled across them, and
    <a href={`${base}/surveys/`}>survey</a> manuscripts. My record lives in the
    <a href={`${base}/cv/`}>curriculum vitae</a>.
  </p>
</Base>

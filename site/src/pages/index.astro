---
import Base from '../layouts/Base.astro'
import Mark from '../components/Mark.astro'
import ProfileLinks from '../components/ProfileLinks.astro'
import { name, nameCJK, tagline } from '../lib/profile'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const description = `${name} (${nameCJK}). ${tagline}`
---

<Base title={`${name} ${nameCJK}`} bare description={description}>
  <section class="profile">
    <Mark class="profile-mark" />
    <div class="profile-text">
      <h1 class="profile-name">
        {name} <span class="profile-name-cjk" lang="zh-Hans">{nameCJK}</span>
      </h1>
      <p class="profile-tagline">{tagline}</p>
      <ProfileLinks class="profile-contacts" />
    </div>
  </section>
  {/* The intro answers the questions a visitor brings, not the CV or
      the nav, which have their own homes: the question as a heading,
      a short answer. More questions (what is interesting here, what's
      new) wait for the content to back them. */}
  <h2>Why this site?</h2>
  <p class="profile-intro">
    This is a personal digital garden, kept in the open, for three reasons:
  </p>
  <ul class="profile-intro">
    <li>
      <strong>To share:</strong> whatever I build or learn that can be
      public.
    </li>
    <li>
      <strong>To connect:</strong> with people anywhere who care about the
      same things.
    </li>
    <li>
      <strong>To provide a shared context:</strong> for any agent, mine
      or yours, through this site and its
      <a href="https://github.com/qobilidop/garden">repository</a>, so
      collaboration starts from the same page.
    </li>
  </ul>
  <h2>Who is behind it?</h2>
  <p class="profile-intro">
    An engineer by trade and a physicist by training. I work on formal
    methods for network hardware at Google and serve on the
    <a href="https://p4.org/">P4</a> Technical Steering Team. Before
    software I spent ten years in physics, and the questions that took me
    there have not let go: what is truth, what is reality, what is
    intelligence, what is consciousness, what makes us human. For the
    professional record, see the <a href={`${base}/cv/`}>CV</a>.
  </p>
</Base>

---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import { extractTitle, fieldOf } from '../lib/works'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const wiki = await getCollection('wiki')
const library = await getCollection('library')
const surveys = await getCollection('surveys')
const recent = library
  .map((e) => ({
    id: e.id,
    title: extractTitle(e.body ?? '') ?? e.id,
    retrieved: fieldOf(e, 'retrieved') ?? '',
  }))
  .sort((a, b) => b.retrieved.localeCompare(a.retrieved))
  .slice(0, 5)
---

<Base description="A personal research system: a wiki distilling a reading library.">
  <h1>sys0</h1>
  <p>
    The public face of a personal research system. Three layers live here,
    in order of refinement: the
    <a href={`${base}/library/`}>library</a> — the works themselves, papers
    and posts, each with synthesis notes — the
    <a href={`${base}/wiki/`}>wiki</a> — living topic pages that distill
    the library across works — and
    <a href={`${base}/surveys/`}>surveys</a> — manuscripts of systematic
    review campaigns run under a pinned method. Wiki pages cite works; work
    pages list the topics that cite them.
  </p>
  <p>
    Everything is rendered from
    <a href="https://github.com/qobilidop/sys0">the repository</a>, where
    the system itself — its conventions, skills, and tools — is developed
    in the open.
  </p>

  <h2>Recently ingested</h2>
  <ul>
    {
      recent.map((w) => (
        <li>
          <a href={`${base}/library/${w.id}/`}>{w.title}</a>
        </li>
      ))
    }
  </ul>

  <h2>Topics</h2>
  <ul>
    {
      wiki.map((e) => (
        <li>
          <a href={`${base}/wiki/${e.id}/`}>{extractTitle(e.body ?? '') ?? e.id}</a>
        </li>
      ))
    }
  </ul>

  <h2>Surveys</h2>
  <ul>
    {
      surveys.map((e) => (
        <li>
          <a href={`${base}/surveys/${e.id}/`}>{extractTitle(e.body ?? '') ?? e.id}</a>
        </li>
      ))
    }
  </ul>
</Base>

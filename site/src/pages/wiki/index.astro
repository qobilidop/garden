---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { extractTitle } from '../../lib/works'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const entries = (await getCollection('wiki'))
  .map((e) => ({ id: e.id, title: extractTitle(e.body ?? '') ?? e.id }))
  .sort((a, b) => a.title.localeCompare(b.title))
---

<Base title="wiki">
  <h1>Wiki</h1>
  <p>
    Living topic pages distilling the library across works. A page exists
    only once enough material has accumulated to synthesize.
  </p>
  <ul>
    {
      entries.map((e) => (
        <li>
          <a href={`${base}/wiki/${e.id}/`}>{e.title}</a>
        </li>
      ))
    }
  </ul>
</Base>

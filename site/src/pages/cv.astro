---
import Base from '../layouts/Base.astro'
import { cv, dates } from '../lib/cv'
import { nameCJK } from '../lib/profile'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const asOf = cv.as_of.toISOString().slice(0, 10)
const description = `Curriculum vitae of ${cv.name}, current as of ${asOf}.`

// Author strings render with the CV's owner in bold.
const authorParts = (authors: string) => authors.split(cv.name)

const linkLabels: Record<string, string> = {
  site: 'qobilidop.com',
  github: 'GitHub',
  linkedin: 'LinkedIn',
  scholar: 'Google Scholar',
}
---

<Base title="Curriculum Vitae" description={description}>
  <article class="cv">
    <header class="cv-header">
      <h1>{cv.name} <span class="cv-name-cjk" lang="zh-Hans">{nameCJK}</span></h1>
      <p class="cv-meta">
        Curriculum vitae · current as of {asOf} ·
        <a href={`${base}/cv.pdf`}>PDF</a>
      </p>
      <p class="cv-links">
        {
          Object.entries(cv.links).map(([key, href], i) => (
            <>
              {i > 0 && ' · '}
              <a href={href}>{linkLabels[key] ?? key}</a>
            </>
          ))
        }
      </p>
    </header>

    <section>
      <h2>Employment</h2>
      {
        cv.employment.map((e) => (
          <div class="cv-entry">
            <span class="cv-dates">{dates(e)}</span>
            <span>
              {e.role}, {e.org}
              {e.note && <span class="cv-note">{e.note}</span>}
            </span>
          </div>
        ))
      }
    </section>

    <section>
      <h2>Education</h2>
      {
        cv.education.map((e) => (
          <div class="cv-entry">
            <span class="cv-dates">{dates(e)}</span>
            <span>
              {e.degree}, {e.org}
              {e.note && <span class="cv-note">{e.note}</span>}
            </span>
          </div>
        ))
      }
    </section>

    <section>
      <h2>Service</h2>
      {
        cv.service.map((s) => (
          <div class="cv-entry">
            <span class="cv-dates">{dates(s)}</span>
            <span>
              <a href={s.url}>{s.role}</a>, {'event' in s ? s.event : s.org}
              {s.note && <span class="cv-note">{s.note}</span>}
            </span>
          </div>
        ))
      }
    </section>

    <section>
      <h2>Talks</h2>
      {
        cv.talks.map((t) => (
          <div class="cv-entry">
            <span class="cv-dates">{dates(t)}</span>
            <span>
              <a href={t.url}>{t.title}</a>. {t.event}.
              {t.note && <span class="cv-note">{t.note}</span>}
            </span>
          </div>
        ))
      }
    </section>

    <section>
      <h2>Publications</h2>
      {
        cv.publications.map((p) => (
          <div class="cv-entry">
            <span class="cv-dates">{p.year}</span>
            <span>
              <a href={p.url}>{p.title}</a>.
              <span class="cv-authors">
                {authorParts(p.authors).map((part, i) => (
                  // prettier-ignore
                  <>{i > 0 && <strong>{cv.name}</strong>}{part}</>
                ))}
              </span>
              <span class="cv-venue">{p.venue}.</span>
              {p.note && <span class="cv-note">{p.note}</span>}
            </span>
          </div>
        ))
      }
    </section>
  </article>
</Base>

<style>
  .cv-header h1 {
    margin-bottom: 0.25rem;
  }
  .cv-name-cjk {
    font-weight: normal;
    color: var(--muted);
  }
  .cv-meta,
  .cv-links {
    margin: 0.25rem 0;
    font-family: var(--sans);
    font-size: 0.9rem;
    color: var(--muted);
  }
  .cv section {
    margin-top: 2rem;
  }
  .cv h2 {
    font-size: 1.1rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.3rem;
  }
  .cv-entry {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0 1rem;
    margin: 0.6rem 0;
  }
  .cv-dates {
    font-family: var(--sans);
    font-size: 0.85rem;
    color: var(--muted);
    padding-top: 0.15rem;
    white-space: nowrap;
  }
  .cv-authors,
  .cv-venue {
    display: block;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .cv-authors strong {
    color: var(--fg);
  }
  .cv-note {
    display: block;
    font-size: 0.92rem;
    color: var(--muted);
  }
  @media (max-width: 40rem) {
    .cv-entry {
      grid-template-columns: 1fr;
    }
  }
</style>

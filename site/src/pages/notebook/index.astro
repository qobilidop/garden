---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { extractTitle } from '../../lib/works'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
// ID order: IDs are minted sequentially, so the listing is the notebook's
// own ledger, entry note first.
const entries = (await getCollection('notebook'))
  .map((e) => ({ id: e.id, title: extractTitle(e.body ?? '') ?? e.id }))
  .sort((a, b) => a.id.localeCompare(b.id))
---

<Base title="notebook">
  <h1>Notebook</h1>
  <p>
    My own understanding, written by hand: the human layer above the
    wiki's synthesis and the library's sources.
  </p>
  <ul class="work-list">
    {
      entries.map((e) => (
        <li>
          <a href={`${base}/notebook/${e.id}/`}>{e.title}</a>
          <span class="tag">
            <span class="handle">{e.id}</span>
          </span>
        </li>
      ))
    }
  </ul>
</Base>

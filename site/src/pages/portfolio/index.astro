---
import Base from '../../layouts/Base.astro'
import { portfolio } from '../../lib/portfolio'
import { handle } from '../../lib/profile'
import { monthLabel } from '../../lib/recency'

// Newest first; the label is the month the work started.
const entries = [...portfolio].sort((a, b) => b.started.localeCompare(a.started))
// Ledger convention: label a month only on its first (newest) entry;
// each entry's exact start date links to its first commit.
const labels = entries.map((e, i) => {
  const m = monthLabel(e.started)
  return i > 0 && monthLabel(entries[i - 1].started) === m ? undefined : m
})
---

<Base title="portfolio">
  <h1>Portfolio</h1>
  <p>
    A curated record of what I build. Each entry lives in its own
    repository; the rest of my code is on
    <a href={`https://github.com/${handle}`}>GitHub</a>.
  </p>
  <ul class="work-list">
    {
      entries.map((e, i) => (
        <li>
          <a href={e.url}>{e.title}</a>
          {labels[i] && (
            <span class="tag">
              <span class="month">{labels[i]}</span>
            </span>
          )}
          <span class="synthesis">
            {e.summary} <a href={e.repository}>Repository</a> · started
            <a href={`${e.repository}/commit/${e.first_commit}`}>{e.started}</a>.
          </span>
        </li>
      ))
    }
  </ul>
</Base>

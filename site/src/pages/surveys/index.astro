---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { extractTitle } from '../../lib/works'
import { monthLabel, newest, surveyUpdatedAt } from '../../lib/recency'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
// Newest update first; the label is the update month.
const entries = newest(
  (await getCollection('surveys')).map((e) => ({
    id: e.id,
    title: extractTitle(e.body ?? '') ?? e.id,
    timestamp: surveyUpdatedAt(e.id),
  })),
  Infinity,
)
// Ledger convention: label a month only on its first (newest) entry.
const labels = entries.map((e, i) => {
  const m = monthLabel(e.timestamp)
  return i > 0 && monthLabel(entries[i - 1].timestamp) === m ? undefined : m
})
---

<Base title="surveys">
  <h1>Surveys</h1>
  <p>
    Manuscripts of survey campaigns: systematic maps and reviews,
    each backed by its survey record — method, searches, catalog,
    and evidence notes — in the repository.
  </p>
  <ul class="work-list">
    {
      entries.map((e, i) => (
        <li>
          <a href={`${base}/surveys/${e.id}/`}>{e.title}</a>
          {labels[i] && (
            <span class="tag">
              <span class="month">{labels[i]}</span>
            </span>
          )}
        </li>
      ))
    }
  </ul>
</Base>

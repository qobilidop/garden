---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { extractTitle } from '../../lib/works'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const entries = (await getCollection('surveys'))
  .map((e) => ({ id: e.id, title: extractTitle(e.body ?? '') ?? e.id }))
  .sort((a, b) => a.title.localeCompare(b.title))
---

<Base title="surveys">
  <h1>Surveys</h1>
  <p>
    Manuscripts of survey campaigns: systematic maps and reviews,
    each backed by its survey record — method, searches, catalog,
    and evidence notes — in the repository.
  </p>
  <ul>
    {
      entries.map((e) => (
        <li>
          <a href={`${base}/surveys/${e.id}/`}>{e.title}</a>
        </li>
      ))
    }
  </ul>
</Base>

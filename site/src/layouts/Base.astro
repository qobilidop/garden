---
import 'katex/dist/katex.min.css'
import '../styles/global.css'
import Mark from '../components/Mark.astro'
import ProfileLinks from '../components/ProfileLinks.astro'
import { name } from '../lib/profile'

interface Props {
  title?: string
  // Use the title as-is, without the "· site" suffix (the landing page).
  bare?: boolean
  description?: string
  // Keep the page out of the Pagefind index (the 404 page).
  noindex?: boolean
}

const { title, bare = false, description, noindex = false } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const siteName = name
// One canonical address however the page was reached (aliases 301 here).
const canonical = new URL(Astro.url.pathname, Astro.site)
const pageTitle = title ? (bare ? title : `${title} · ${siteName}`) : siteName
// Unfurl image: the flat-white 1024 brand master (square → summary card).
const ogImage = new URL(`${base}/brand/logo-black.png`, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" sizes="any" />
    <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
    <script is:inline>
      // Pre-paint: apply the stored theme choice before first render so
      // an explicit toggle never flashes the system theme.
      const t = localStorage.getItem('theme')
      if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t
    </script>
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a href={`${base}/`} class="brand"><Mark class="brand-mark" />{siteName}</a>
        <span class="nav-sections">
          <a href={`${base}/library/`}>library</a>
          <a href={`${base}/wiki/`}>wiki</a>
          <a href={`${base}/surveys/`}>surveys</a>
        </span>
        <span class="nav-utilities">
          <a href={`${base}/search/`}>search</a>
          <a href="https://github.com/qobilidop/garden">source</a>
          <button
            id="theme-toggle"
            class="theme-toggle"
            aria-label="Toggle light/dark theme"
            title="Toggle light/dark theme"
          >◐</button>
        </span>
      </nav>
    </header>
    {/* Astro stringifies booleans on data-* attributes; undefined omits. */}
    <main data-pagefind-body={noindex ? undefined : ''}>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        code <a href="https://github.com/qobilidop/garden/blob/main/LICENSE-MIT">MIT</a> ·
        non-code
        <a href="https://github.com/qobilidop/garden/blob/main/LICENSE-CC-BY">CC BY 4.0</a>
      </p>
      <ProfileLinks class="footer-links" />
    </footer>
    <script>
      // Theme toggle: flip from the currently effective theme; the
      // choice persists and overrides prefers-color-scheme (pre-paint
      // script in <head>).
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const explicit = document.documentElement.dataset.theme
        const effective =
          explicit ??
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        const next = effective === 'dark' ? 'light' : 'dark'
        document.documentElement.dataset.theme = next
        localStorage.setItem('theme', next)
      })
    </script>
    <script>
      // Mermaid renders client-side, loaded only on pages that need it.
      const blocks = document.querySelectorAll<HTMLElement>(
        'pre > code.language-mermaid, pre[data-language="mermaid"]',
      )
      if (blocks.length > 0) {
        const { default: mermaid } = await import('mermaid')
        // Bind the diagram theme to the page's grayscale tokens (never
        // filter-invert — it breaks non-line-art).
        const css = getComputedStyle(document.documentElement)
        const v = (name: string) => css.getPropertyValue(name).trim()
        mermaid.initialize({
          startOnLoad: false,
          theme: 'base',
          themeVariables: {
            background: v('--bg'),
            primaryColor: v('--bg-raised'),
            primaryTextColor: v('--fg'),
            primaryBorderColor: v('--muted'),
            lineColor: v('--muted'),
            fontFamily: v('--sans') || 'sans-serif',
          },
        })
        const nodes: HTMLElement[] = []
        for (const block of blocks) {
          const pre = block.tagName === 'PRE' ? block : block.parentElement!
          const div = document.createElement('div')
          div.className = 'mermaid'
          div.textContent = block.textContent ?? ''
          pre.replaceWith(div)
          nodes.push(div)
        }
        await mermaid.run({ nodes })
      }
    </script>
  </body>
</html>
